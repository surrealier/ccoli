# Opt-in worker: the normal voice server never installs Torch or LeRobot.
FROM python:3.12-slim-bookworm
ARG TORCH_WHEEL_INDEX=https://download.pytorch.org/whl/cpu
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    HF_HOME=/cache/huggingface HF_HUB_DISABLE_IMPLICIT_TOKEN=1 \
    HF_HUB_DISABLE_TELEMETRY=1 WANDB_MODE=disabled DO_NOT_TRACK=1 \
    PYTHONPATH=/app/server
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg libgl1 libglib2.0-0 libgomp1 && rm -rf /var/lib/apt/lists/*
# Install dependencies before source to keep subsequent builds fast.
RUN pip install --no-cache-dir torch==2.10.0 torchvision==0.25.0 \
    --index-url ${TORCH_WHEEL_INDEX}
RUN pip install --no-cache-dir 'lerobot[smolvla,training,feetech]==0.6.1' \
    transformers==5.5.0 torchcodec==0.10.0 pytest==9.1.1
WORKDIR /app
COPY server/src/__init__.py /app/server/src/__init__.py
COPY server/src/robotics /app/server/src/robotics
COPY scripts/robotics_policy.py /app/scripts/robotics_policy.py
ENTRYPOINT ["python", "/app/scripts/robotics_policy.py"]
CMD ["--help"]
