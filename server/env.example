# LLM providers
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3.5:4b
GEMINI_MODEL=gemini-3.8-flash
CLAUDE_MODEL=claude-sonnet-5-5
CHATGPT_MODEL=gpt-6-luna

# API keys
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Google Calendar integration (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIME_ZONE=Asia/Seoul

# Telegram channel (optional)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_MIN_INTERVAL_SEC=0.5
TELEGRAM_POLL_INTERVAL_SEC=1.0
TELEGRAM_LONG_POLL_TIMEOUT_SEC=20

# Runtime priority
LLM_PRIORITY=ollama,api,ollama_cpu,other
LLM_API_PRIORITY=gemini,claude,chatgpt
CONNECTION_PRIORITY=wired,wifi
PROCESSOR_PRIORITY=gpu,cpu

# STT / TTS
STT_MODEL_SIZE=turbo
STT_DEVICE=cuda
STT_LANGUAGE=auto
# auto/ko/en/zh/ja/es; conversation setting overrides legacy STT_LANGUAGE
DIALOGUE_LANGUAGE=auto
DIALOGUE_SHORT_RESPONSES=true
# Optional fast model; leave empty until you compare quality and latency
DIALOGUE_FAST_MODEL=
TTS_BACKEND=edge_tts
TTS_VOICE=ko-KR-SunHiNeural
TTS_MODEL=gemini-3.8-flash-lite-tts
TTS_GEMINI_VOICE=Kore

# Personal agent (opt-in), local dashboard and optional Home Assistant
AGENT_ENABLED=false
AGENT_STATE_PATH=
WEB_HOST=127.0.0.1
WEB_PORT=8005
# Shared dashboard token for REST and WebSocket events. Keep the value private.
# Enter it once in Diagnostics > Advanced in the browser. Never put it in a URL.
WEB_AUTH_TOKEN=
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
HOME_ASSISTANT_ALLOWED_ENTITIES=

# Inference latency controls (CPU fallback / decoding)
STT_CPU_THREADS=4
STT_BEAM_SIZE=1
